# ── Application ───────────────────────────────────────────────
APP_NAME="Multi-Tenant Doc Intelligence API"
APP_ENV=development
DEBUG=True
SECRET_KEY=your-super-secret-key-minimum-32-chars

# ── Database ──────────────────────────────────────────────────
# PRODUCTION: Always use PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/docdb

# LOCAL FALLBACK ONLY (remove in production):
# DATABASE_URL=sqlite+aiosqlite:///./local_dev.db
# ⚠️ PRODUCTION MIGRATION NOTE:
#    If switching from SQLite to PostgreSQL:
#    1. Change DATABASE_URL to postgresql+asyncpg://...
#    2. Drop SQLite file
#    3. Run: alembic upgrade head
#    4. Ensure pgvector extension: CREATE EXTENSION vector;

# Alembic uses sync driver — keep this separate
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/docdb

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── File Upload ───────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=pdf,docx,txt,md

# ── AI Provider ───────────────────────────────────────────────
AI_PROVIDER_API_KEY=your-gemini-api-key
AI_EMBEDDING_MODEL=models/embedding-001
AI_EMBEDDING_DIMENSION=768

# ── CORS ──────────────────────────────────────────────────────
# PRODUCTION: Replace * with your actual frontend domain
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000